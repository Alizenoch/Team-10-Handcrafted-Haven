# Environment variables for Prisma and Next.js

# Postgres connection string (Neon)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-neon-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT secret for authentication
JWT_SECRET=your_random_secret_here

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=some_random_secure_string

# GitHub OAuth (replace with real values from GitHub Developer settings)
GITHUB_ID=your_real_client_id
GITHUB_SECRET=your_real_client_secret
